# Production settings for docker-compose.yml. Copy to .env and fill in.
DOMAIN=chores.the-raifs.me
ACME_EMAIL=alon.raif@gmail.com
TIMEZONE=Asia/Jerusalem

# openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Android app notifications: base64 of the Firebase service account JSON (base64 -i key.json)
FIREBASE_SERVICE_ACCOUNT=

# Kitchen display (docker compose --profile cast). DISPLAY_URL comes from Family → Kitchen display.
HUB_IP=
DISPLAY_URL=
CAST_FROM=07:00
CAST_UNTIL=21:00

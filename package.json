{
  "name": "chorly",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "predev": "pnpm --filter @chorly/shared build",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter chorly-api prisma:generate",
    "db:migrate": "pnpm --filter chorly-api prisma:migrate",
    "db:seed": "pnpm --filter chorly-api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<1.20.9": "^1.20.9",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "proxy-addr@<2.0.8": "^2.0.8"
    }
  }
}
